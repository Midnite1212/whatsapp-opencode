{
  "$schema": "https://opencode.ai/config.json",
  // Explicit absolute skills path: OPENCODE_CONFIG_DIR covers agents/commands/plugins
  // but NOT skills, and the bot's cwd isn't reliably /workspace — so point here directly.
  "skills": {
    "paths": ["/workspace/.opencode/skills"]
  },
  // Load AGENTS.md by absolute path so it applies regardless of cwd (carries the
  // attribution rule + skill guidance).
  "instructions": ["/workspace/AGENTS.md"],
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    // Self-hosted LLM (OpenAI-compatible: Ollama .../v1, LM Studio .../v1,
    // KoboldCpp .../v1). baseURL comes from LOCAL_LLM_URL (must be a PUBLIC tunnel
    // url, not localhost, since the bot runs on Railway).
    // IMPORTANT: OpenCode only accepts model ids that are LISTED under "models"
    // below. Get your exact ids from `GET /v1/models` on your server, list each one
    // here, and point LOCAL_LLM_MODEL (general) + LOCAL_LLM_MODEL_STRUCTURAL
    // (coding/tools) at them. (LOCAL_LLM_MODEL=auto only works if the discovered model
    // is also listed here.) The examples below are this project's current models —
    // change them to yours.
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "{env:LOCAL_LLM_URL}",
        "apiKey": "{env:LOCAL_LLM_API_KEY}",
        // ngrok free tier serves an HTML warning page without this header, which
        // would break OpenCode's JSON calls. Harmless on Cloudflare/other tunnels.
        "headers": { "ngrok-skip-browser-warning": "true" }
      },
      "models": {
        // limit.output caps the reserved response size (OpenCode otherwise asks for
        // ~32k, which overflows small windows). limit.context MUST be <= the context you
        // actually LOAD the model with in LM Studio — changing it here alone does nothing.
        // 16384 is too small for agentic tool-use: OpenCode's system prompt + built-in
        // tools + even a scoped GitHub MCP is ~18.8k tokens before any work, so it
        // overflowed (n_keep > n_ctx). 32k clears that with room for the tool loop.
        // VRAM: a 27B at Q4 + 32k KV is ~20-22GB — usually fits 24GB; higher quants spill,
        // in which case drop to 24576 or use a smaller coder model (e.g. qwen2.5-coder-14B).
        "qwen/qwen3.6-27b": { "limit": { "context": 32768, "output": 4096 } }
      }
    }
  },
  "mcp": {
    // Remote MCPs need nothing extra in the image. Flip "enabled" to true (and set
    // the relevant env var) once you're on a paid model that handles tools well.
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "github": {
      // NOTE: this "enabled" is OVERRIDDEN AT RUNTIME by the GITHUB_MCP_ENABLED env var
      // (core._build_runtime_config regenerates the config) — flip it from Railway, not
      // here. Off by default: the remote MCP must be reached on every run and, on a small
      // local model, bloats context / hangs at init if its token is missing.
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
        // Scope to ONLY the toolsets our skills use. The full Copilot MCP exposes dozens of
        // tools (actions, code/secret scanning, dependabot, notifications, gists, …) whose
        // schemas flooded the local model's window (n_keep 20559 > n_ctx 16384). repos
        // (read files + create_branch + push_files), pull_requests (open PR), issues.
        "X-MCP-Toolsets": "repos,issues,pull_requests"
      },
      "enabled": false
    }
    // TODO: Flip once in the paid stream — semantic code nav/edit via LSP → more accurate tweaks.
    // Local MCP: needs `uv`/`uvx` added to the Dockerfile first (not installed yet).
    // "serena": {
    //   "type": "local",
    //   "command": ["uvx", "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server"],
    //   "enabled": false
    // }
  }
}
