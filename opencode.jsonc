{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    },
    // Self-hosted LLM (OpenAI-compatible: Ollama .../v1, LM Studio .../v1,
    // KoboldCpp .../v1). baseURL comes from LOCAL_LLM_URL (must be a PUBLIC tunnel
    // url, not localhost, since the bot runs on Railway).
    // IMPORTANT: OpenCode only accepts model ids that are LISTED under "models"
    // below. Get your exact ids from `GET /v1/models` on your server, list each one
    // here, and point LOCAL_LLM_MODEL (general) + LOCAL_LLM_MODEL_STRUCTURAL
    // (coding/tools) at them. (LOCAL_LLM_MODEL=auto only works if the discovered model
    // is also listed here.) The examples below are this project's current models —
    // change them to yours.
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local LLM",
      "options": {
        "baseURL": "{env:LOCAL_LLM_URL}",
        "apiKey": "{env:LOCAL_LLM_API_KEY}",
        // ngrok free tier serves an HTML warning page without this header, which
        // would break OpenCode's JSON calls. Harmless on Cloudflare/other tunnels.
        "headers": { "ngrok-skip-browser-warning": "true" }
      },
      "models": {
        // limit.output caps the reserved response size (OpenCode otherwise asks for
        // ~32k, which overflows small windows). limit.context must be <= the context
        // you load the model with in LM Studio. Raise both if your VRAM allows.
        "qwen/qwen3.6-27b": { "limit": { "context": 24576, "output": 4096 } }
      }
    }
  },
  "mcp": {
    // Remote MCPs need nothing extra in the image. Flip "enabled" to true (and set
    // the relevant env var) once you're on a paid model that handles tools well.
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": { "Authorization": "Bearer {env:GITHUB_TOKEN}" },
      "enabled": false
    }
    // TODO: Flip once in the paid stream — semantic code nav/edit via LSP → more accurate tweaks.
    // Local MCP: needs `uv`/`uvx` added to the Dockerfile first (not installed yet).
    // "serena": {
    //   "type": "local",
    //   "command": ["uvx", "--from", "git+https://github.com/oraios/serena", "serena", "start-mcp-server"],
    //   "enabled": false
    // }
  }
}
